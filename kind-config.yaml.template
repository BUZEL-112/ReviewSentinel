kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  # 1. Mount your host filesystem into the kind node
  extraMounts:
  - hostPath: ${PROJECT_ROOT}/data
    containerPath: /data
  - hostPath: ${PROJECT_ROOT}/artifacts
    containerPath: /artifacts
  - hostPath: ${PROJECT_ROOT}/configs
    containerPath: /configs
  - hostPath: ${PROJECT_ROOT}/src  
    containerPath: /src
  # 2. Map the node port to the Codespace host
  extraPortMappings:
  - containerPort: 30080
    hostPort: 30080
    protocol: TCP